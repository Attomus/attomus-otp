      "raw_base64": "Ci4KCkhlbGxvId6tvu8SEWFsaWNlQGV4YW1wbGUuY29tGgdFeGFtcGxlIAEoATACEAEYASAAKOdW",
      "expected": [
        {
          "type": "TOTP",
          "issuer": "Example",
          "label": "alice@example.com",
          "algorithm": "SHA1",
          "digits": 6,
          "period": 30,
          "secret_hex": "48656c6c6f21deadbeef",
          "counter": null
        }
      ]
    },
